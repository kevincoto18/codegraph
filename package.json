{
  "name": "codegraph",
  "displayName": "CodeGraph Map",
  "description": "Interactive graph of files, functions, imports and calls for TypeScript, JavaScript, Python, Java, C# and Go projects.",
  "version": "0.1.0",
  "publisher": "kcoto18",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Kevin Coto"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1B1F27",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kevincoto18/codegraph.git"
  },
  "bugs": {
    "url": "https://github.com/kevincoto18/codegraph/issues"
  },
  "homepage": "https://github.com/kevincoto18/codegraph#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "graph",
    "call graph",
    "dependency graph",
    "code map",
    "visualization",
    "architecture",
    "navigation",
    "imports",
    "functions",
    "typescript",
    "javascript",
    "python",
    "java",
    "csharp",
    "go",
    "react flow"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:codegraph.graph"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Files are read through the VS Code file system, so virtual and remote repositories can be analyzed; very large ones can be slow to scan."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codegraph.openGraph",
        "title": "Open Graph",
        "category": "CodeGraph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codegraph.showPerformanceReport",
        "title": "Show Performance Report",
        "category": "CodeGraph"
      },
      {
        "command": "codegraph.showConnections",
        "title": "Show Connections",
        "category": "CodeGraph",
        "icon": "$(target)"
      }
    ],
    "keybindings": [
      {
        "command": "codegraph.openGraph",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "configuration": {
      "title": "CodeGraph",
      "properties": {
        "codegraph.collapseByDefault": {
          "type": "string",
          "enum": [
            "always",
            "auto",
            "never"
          ],
          "default": "always",
          "enumDescriptions": [
            "Every file starts collapsed.",
            "Files start collapsed only in large graphs (more than 400 functions).",
            "Every file starts expanded."
          ],
          "description": "Whether file containers start collapsed when the graph is opened."
        },
        "codegraph.folderView": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Group files into folders only in large graphs (more than 300 files).",
            "Always group files into folders.",
            "Never group files into folders: show every file at the top level."
          ],
          "description": "Whether files are grouped into nested folder containers that expand on demand."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "codegraph.showConnections",
          "when": "resourceExtname =~ /^\\.(ts|tsx|js|jsx|py|java|cs|go)$/",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "command": "codegraph.showConnections",
          "when": "resourceExtname =~ /^\\.(ts|tsx|js|jsx|py|java|cs|go)$/",
          "group": "navigation@90"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.mjs",
    "build:webview": "vite build",
    "watch:extension": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/webview/tsconfig.json && tsc -p src/test/integration/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && node scripts/build-integration-tests.mjs && vscode-test",
    "package": "vsce package",
    "bench": "node scripts/run.mjs scripts/bench.ts",
    "bench:baseline": "node scripts/run.mjs scripts/bench.ts --save-baseline",
    "bench:check": "node scripts/run.mjs scripts/bench.ts --check",
    "stress": "node scripts/run.mjs scripts/stress.ts",
    "stress:full": "node scripts/run.mjs scripts/stress.ts --sizes S,M,L,XL",
    "stress:ui": "node scripts/run.mjs scripts/stress-ui.ts",
    "stress:generate": "node scripts/run.mjs scripts/generate-stress-project.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vscode:prepublish": "npm run typecheck && npm test && node esbuild.mjs --production && vite build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.95.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@vscode/vsce": "^4.1.1",
    "@xyflow/react": "^13.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "ignore": "^7.0.16",
    "mocha": "^12.0.3",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
