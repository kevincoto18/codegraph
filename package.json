{
  "name": "codegraph",
  "displayName": "CodeGraph",
  "description": "Interactive graph of files, functions, imports and calls for TypeScript/JavaScript projects.",
  "version": "0.0.1",
  "publisher": "kevin",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codegraph.openGraph",
        "title": "Open Graph",
        "category": "CodeGraph",
        "icon": "$(type-hierarchy)"
      }
    ],
    "keybindings": [
      {
        "command": "codegraph.openGraph",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "configuration": {
      "title": "CodeGraph",
      "properties": {
        "codegraph.collapseByDefault": {
          "type": "string",
          "enum": [
            "always",
            "auto",
            "never"
          ],
          "default": "always",
          "enumDescriptions": [
            "Every file starts collapsed.",
            "Files start collapsed only in large graphs (more than 400 functions).",
            "Every file starts expanded."
          ],
          "description": "Whether file containers start collapsed when the graph is opened."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.mjs",
    "build:webview": "vite build",
    "watch:extension": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/webview/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vscode:prepublish": "npm run typecheck && npm test && node esbuild.mjs --production && vite build"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.95.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^13.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
