{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "vscode"]
  },
  "include": [
    "src/extension/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.mts",
    "vite.mini.config.mts",
    "vitest.config.mts"
  ]
}
